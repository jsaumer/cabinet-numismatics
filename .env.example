# Copy to .env and change all secrets before running.

# Sign-in (v0.30.0).
# The exact address(es) browsers use to reach Cabinet, scheme://host[:port],
# comma-separated. Required: the backend and the proxy both refuse to start
# without it. Cookie requests are only accepted from these origins. The local
# stack is reached as http://localhost (and as http://proxy by the dockerised
# Playwright runs). A real deployment sets its https address here, e.g.
# PUBLIC_ORIGINS=https://cabinet.example.com, and removes AUTH_INSECURE_HTTP.
PUBLIC_ORIGINS=http://localhost,http://proxy
# Extra Host names nginx answers besides those of PUBLIC_ORIGINS: internal
# names such as cabinet_proxy (Homepage, Prometheus) or a LAN name. Any other
# Host gets no response.
ALLOWED_HOSTS=localhost,proxy
# Cookies without Secure, for plain http. ONLY for a local stack on this
# machine: on a network, the password would travel in clear text. Remove
# it (or set false) for any real deployment; it is refused beside an https
# origin, so a copied file can't keep it by mistake.
AUTH_INSECURE_HTTP=true
# The port the proxy publishes (default 80).
# CABINET_PORT=80
# The one-time setup code for creating the admin. Leave unset and Cabinet
# generates one and prints it in `docker compose logs backend`; or set it
# (at least 32 characters: openssl rand -hex 32), or point SETUP_CODE_FILE at
# a file holding it (a Docker secret). Ignored once the admin exists.
# SETUP_CODE=
# SETUP_CODE_FILE=

# The backup key every archive is encrypted with: a file of age identities
# (AGE-SECRET-KEY-1..., one a line, the first encrypting), typically a Docker
# secret. Leave unset and Cabinet generates one on the state volume. Either
# way, save a copy outside Cabinet:
#   docker compose exec backend python -m app.cli backup-key show
# BACKUP_KEY_FILE=
# Or the key itself (the AGE-SECRET-KEY line from `python -m app.cli backup-key
# new`), for a secret manager that sets variables. Not both.
# BACKUP_KEY=

# Single sign-on (v0.33.0), the trusted-header mode: sign in from a signed JWT
# an authenticating gateway puts in a header. Header mode needs all four
# TRUSTED_ASSERTION_* variables set, or none (the mode off): a partial set
# stops startup.
# The header carrying the gateway's signed JWT (e.g. X-authentik-jwt).
# TRUSTED_ASSERTION_HEADER=
# Where the gateway's public keys are (https://; http:// only with AUTH_INSECURE_HTTP).
# TRUSTED_ASSERTION_JWKS_URL=
# The `iss` the assertion must carry.
# TRUSTED_ASSERTION_ISSUER=
# The `aud` the assertion must carry; never empty.
# TRUSTED_ASSERTION_AUDIENCE=
# A PEM file of CA certificates added to the public roots, for a provider or
# gateway behind a local CA.
# SSO_CA_FILE=

# Postgres
DB_USER=numis
DB_PASSWORD=changeme
DB_NAME=numismatics

# Re-run stale melt estimates this often (days); 0 disables the scheduler.
# REESTIMATE_DAYS=7

# The backend applies pending database migrations on startup. Set false to run
# `alembic upgrade head` yourself after each deploy instead.
# AUTO_MIGRATE=true

# Restore from inside the app (Settings → Backups) replaces the whole
# collection. Set false to switch it off: every
# restore endpoint then answers 404 and scripts/restore.sh is the only way.
# RESTORE_ENABLED=true
# Largest archive that may be uploaded for a restore, in GB (nginx allows 20).
# RESTORE_MAX_GB=20

# Encrypts stored price-source API keys at rest. Strongly recommended: set this
# explicitly so the keys survive a rebuilt volume and you control rotation.
# Generate with:
#   docker compose run --rm backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, put the NEW key first and keep the old one so existing values still
# decrypt: SECRET_KEY=<new>,<old>
# SECRET_KEY=
